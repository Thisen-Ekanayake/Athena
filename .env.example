# Database
DATABASE_URL=postgresql://athena:athena_password@localhost:5432/athena_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Vector DB
QDRANT_URL=http://localhost:6333

# API Keys (Placeholders)
OPENAI_API_KEY=your_key_here
SEMANTIC_SCHOLAR_API_KEY=your_key_here
CROSSREF_EMAIL=your_email@example.com

# Research evolution (OpenAlex corpus). Without a key the free allowance is $0.10/day;
# a free key from openalex.org/settings/api raises it to $1/day.
OPENALEX_API_KEY=
# Optional contact address OpenAlex asks API users to send
OPENALEX_MAILTO=
# Where OpenAlex responses are cached so rebuilding a topic costs nothing (default ~/.athena/openalex_cache)
OPENALEX_CACHE_DIR=
# Semantic Scholar responses, cached the same way (default ~/.athena/s2_cache). It uses
# SEMANTIC_SCHOLAR_API_KEY above; a value saved in the Settings page takes precedence over this file.
S2_CACHE_DIR=

# Research evolution, Phase 2: full text and the GPU lane
# GROBID parses Tier 2 PDFs; it is a docker-compose service (the worker container is pointed at it there)
GROBID_URL=http://localhost:8070
# PDFs, TEI files and llama-server logs (default ~/.athena/evolution)
EVOLUTION_DATA_DIR=
# llama.cpp server binary and the two GGUF models (paths relative to the repo root work)
LLAMA_SERVER_BIN=llama-server
EVOLUTION_EMBED_MODEL=models/Qwen3-Embedding-8B-Q4_K_M.gguf
EVOLUTION_CHAT_MODEL=models/Qwen3.5-9B-Q4_K_M.gguf
# Where the lane starts (or finds) each server; any OpenAI-compatible endpoint works for chat
EVOLUTION_EMBED_URL=http://127.0.0.1:8081
EVOLUTION_CHAT_URL=http://127.0.0.1:8080

# JWT (used for optional per-item auth)
JWT_SECRET=change-me-in-production

# Swagger / ReDoc auth — set DOCS_PASSWORD to enable Basic Auth on /docs and /redoc
# Leave DOCS_PASSWORD empty (or unset) to disable the docs entirely in production
DOCS_ENABLED=true
DOCS_USERNAME=athena
DOCS_PASSWORD=
